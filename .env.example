# Copy to .env and fill in. Compose refuses to start while a field other than the last is empty.

# Output of `id -u`
SESSIONMAXXING_UID=1000
# Output of `id -g`
SESSIONMAXXING_GID=1000
# Output of `stat -c %g /var/run/docker.sock`
SESSIONMAXXING_DOCKER_GID=
# Your home directory, mounted at the same path inside the container
SESSIONMAXXING_HOME=/home/user
# Address Docker publishes the dashboard on. 127.0.0.1 keeps it on this machine.
# A wider address such as 0.0.0.0 needs the names clients type in SESSIONMAXXING_ALLOWED_HOSTS.
SESSIONMAXXING_BIND_ADDRESS=127.0.0.1
SESSIONMAXXING_PORT=4317
# Edition: full or lite. Lite serves the Queue and Runs pages only.
SESSIONMAXXING_EDITION=full
# IANA zone name such as Europe/Berlin
TZ=UTC
# Extra hostnames or addresses clients use, comma separated. The bind address is always approved.
SESSIONMAXXING_ALLOWED_HOSTS=
