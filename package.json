{
  "name": "sessionmaxxing",
  "version": "1.0.0",
  "type": "module",
  "description": "Fill idle Claude session windows with queued Claude Code tasks while keeping the weekly limit on pace.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexdalat/sessionmaxxing.git"
  },
  "bin": {
    "sessionmaxxing": "dist/server/server/main.js",
    "sessionmaxxing-queue": "scripts/queue-task.mjs"
  },
  "files": [
    "dist/client",
    "dist/server/server",
    "dist/server/shared",
    "scripts/queue-task.mjs",
    "skills"
  ],
  "scripts": {
    "dev": "tsx server/main.ts --dev",
    "dev:ui": "next dev --hostname 127.0.0.1",
    "start": "node dist/server/server/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "build": "next build && rm -rf dist/client && mkdir -p dist && mv out dist/client && tsc -p tsconfig.server.json",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.3.4"
}
